{
  "name": "vanahub-publisher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "action:build": "ncc build src/action.ts -o dist-action --minify",
    "schema:generate": "node scripts/generate-validator.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:parity": "tsx scripts/parity.ts",
    "contracts:check": "node scripts/sync-contracts.mjs --check",
    "contracts:sync": "node scripts/sync-contracts.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "svelte": "^5.38.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "@types/node": "^24.3.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
