{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hildaware.github.io/vanahub-publisher/schemas/publisher-package.schema.json",
  "title": "VanaHub repository publishing configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "author",
    "sourcePath"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "sourcePath": {
      "type": "string",
      "pattern": "^(?:\\.|[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)$"
    },
    "iconUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:vanahub-screenshot-upload\\.hildaware\\.workers\\.dev/pending/[0-9a-f-]{36}/[a-f0-9]{64}\\.(?:jpg|png|webp)|hildaware\\.github\\.io/vanahub-catalog/media/[a-z0-9][a-z0-9._-]{1,63}/[a-f0-9]{64}\\.jpg)$"
    },
    "screenshots": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://(?:vanahub-screenshot-upload\\.hildaware\\.workers\\.dev/pending/[0-9a-f-]{36}/[a-f0-9]{64}\\.(?:jpg|png|webp)|hildaware\\.github\\.io/vanahub-catalog/media/[a-z0-9][a-z0-9._-]{1,63}/[a-f0-9]{64}\\.jpg)$"
      }
    },
    "categories": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "combat",
          "jobs",
          "inventory",
          "crafting",
          "economy",
          "maps-travel",
          "user-interface",
          "chat-communication",
          "data-tracking",
          "quality-of-life",
          "development-tools"
        ]
      }
    }
  }
}
